load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "kodex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "kodex_e2e_benchmark")

kodex_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["kodex"],
    crate_name = "kodex_cli",
    extra_binaries = [
        "//kodex-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "kodex",
)

kodex_e2e_benchmark(
    name = "kodex-help",
    binaries = [":kodex"],
)
